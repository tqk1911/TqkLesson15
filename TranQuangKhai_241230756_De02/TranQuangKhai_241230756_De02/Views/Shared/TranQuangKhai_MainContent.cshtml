@model IEnumerable<TranQuangKhai_241230756_De02.Models.TaiSan>
<div class="section-head">
    <h3>@ViewData["TieuDe"]</h3>
    <a href="#">Xem tất cả &rsaquo;</a>
</div>
<div class="grid">
    @foreach (var t in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@t.Anh" alt="" /></a>
            <h2>@t.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@t.NguyenGia?.ToString("0") tr</span>
                <button class="btn-buy">Chi tiết</button>
                <a href="/TaiSan/Edit/@t.MaTs" class="btn-buy">Sửa</a>
            </div>
        </div>
    }
</div>